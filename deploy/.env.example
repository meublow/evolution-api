# Copie este arquivo para deploy/.env e preencha com valores reais antes de subir.
# Nunca commite o .env de verdade - o .gitignore da raiz do repo ja ignora *.env.

# Dominio publico onde a Evolution API vai responder (usado no SERVER_URL interno da API)
SERVER_URL=https://evolution.blow.ia.br

# Chave de autenticacao da API - gere uma nova, nao reuse a de outra instancia
EVOLUTION_API_KEY=troque-por-uma-chave-forte
